{
  "name": "atgv-react-api-sqlite",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5173\" \"node server/index.mjs\"",
    "start": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "vitest run",
    "test:api": "node --test server/api.test.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "db:migrate": "node server/migrate.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "express": "^4.21.0",
    "drizzle-orm": "^0.44.0",
    "@libsql/client": "^0.15.0",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "vite": "^7.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "typescript": "~5.9.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "vitest": "^3.2.0",
    "jsdom": "^26.1.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.6.0",
    "@playwright/test": "^1.55.0",
    "@axe-core/playwright": "^4.10.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
