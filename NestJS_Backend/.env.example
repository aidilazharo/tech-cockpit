# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
# Comma-separated list of browser origins allowed to call the API
FRONTEND_ORIGINS=http://localhost:5173

# --- Database -------------------------------------------------------------
# The shared Azure PostgreSQL Flexible Server 15.19 (DB_SSL=true); see the Windows company laptop example below
DB_HOST=<server>.postgres.database.azure.com
DB_PORT=5432
DB_NAME=techcockpit
# Your own schema on the shared database, e.g. tc_<yourname>. Tests use <DB_SCHEMA>_test.
DB_SCHEMA=tc_yourname
DB_SSL=true
# How each login signs in: password (default), or azure-cli = an Entra ID access token read from the
# Azure CLI's existing sign-in (`az account get-access-token`; the app never runs `az login` itself),
# fetched as each connection opens; needs DB_SSL=true; no password kept. With azure-cli, the user is
# your Entra name as the database knows it (e.g. firstname.lastname@aia.com).
DB_APP_AUTH=password
DB_MIGRATION_AUTH=password
# Runtime login (no table ownership, so row-level security always applies)
DB_APP_USER=tc_app
DB_APP_PASSWORD=
# Optional: a role the app login switches to as it connects, when it signs in as an identity with more
# rights (e.g. your Entra identity, also the migration login). Your identity must be a member of it.
# DB_APP_ROLE=tc_app
# Migration login (owns the schema; used only by npm run db:migrate)
DB_MIGRATION_USER=tc_owner
DB_MIGRATION_PASSWORD=

# Windows company laptop example (one Entra identity for both logins, the app restricted to tc_app):
#   DB_HOST=<server>.postgres.database.azure.com  DB_PORT=5432  DB_SSL=true  DB_SCHEMA=terry
#   DB_APP_AUTH=azure-cli  DB_APP_USER=<your Entra name>  DB_APP_ROLE=tc_app
#   DB_MIGRATION_AUTH=azure-cli  DB_MIGRATION_USER=<your Entra name>
#   (or DB_APP_AUTH=password with DB_APP_USER=tc_app and its password, if the server allows passwords)

# --- API keys -------------------------------------------------------------
# Maximum lifetime of a personal API key, in days
API_KEY_MAX_TTL_DAYS=90

# --- Rate limiting --------------------------------------------------------
# Requests per minute per client IP
RATE_LIMIT_PER_MINUTE=300

# --- File storage ---------------------------------------------------------
# local (dev) or azure-blob (deployed)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# Deployed: STORAGE_DRIVER=azure-blob with the account's blob endpoint (managed identity; no keys).
# STORAGE_AZURE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# STORAGE_AZURE_CONTAINER=sad-uploads
# STORAGE_AZURE_CLIENT_ID=<user-assigned identity's client id, if not system-assigned>

# --- Browser sign-in (Okta SAML) and sessions ------------------------------
# Public origins (no trailing slash). The SAML ACS URL is <API_BASE_URL>/api/v1/auth/saml/acs
# and the SP entity ID (Okta "Audience URI") is <API_BASE_URL>/api/v1/auth/saml/metadata.
API_BASE_URL=http://localhost:3000
APP_BASE_URL=http://localhost:5173
# Okta app -> Sign On tab -> Metadata URL. Leave empty to disable browser sign-in.
# Behind a corporate proxy, run Node with NODE_USE_ENV_PROXY=1 and HTTPS_PROXY set.
SAML_IDP_METADATA_URL=
# Session token signing key, at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_JWT_SECRET=
# Minutes. Access token lifetime <= idle timeout <= absolute session lifetime.
SESSION_ACCESS_TTL_MINUTES=15
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_MINUTES=240

# TRM: ServiceNow classes (sys_class_name) that mean "application service" in the services
# export. Comma-separated; defaults to the standard ServiceNow application-service classes.
# TRM_APPLICATION_SERVICE_CLASSES=cmdb_ci_service_auto,cmdb_ci_service_discovered,cmdb_ci_service_by_tags,cmdb_ci_query_based_service,cmdb_ci_service_calculated
