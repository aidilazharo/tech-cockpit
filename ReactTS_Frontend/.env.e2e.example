# Okta dev-tenant test users for Playwright e2e logins.
# Copy to .env.e2e.local (git-ignored) and fill in. Never commit real passwords
# and never paste them into chat. These users must have a no-MFA sign-on policy
# in the DEV tenant only.
# Put each password in single quotes, e.g. E2E_VENDOR_PASSWORD='p#ss'. Without quotes,
# everything after a # is treated as a comment and the password is cut short.

E2E_OKTA_ORG_URL=https://dev-000000.okta.com

E2E_SYSTEM_ADMIN_EMAIL=
E2E_SYSTEM_ADMIN_PASSWORD=
E2E_PORTFOLIO_LEAD_EMAIL=
E2E_PORTFOLIO_LEAD_PASSWORD=
E2E_PRODUCT_MANAGER_EMAIL=
E2E_PRODUCT_MANAGER_PASSWORD=
E2E_SOLUTION_ARCHITECT_EMAIL=
E2E_SOLUTION_ARCHITECT_PASSWORD=
E2E_ENTERPRISE_ARCHITECT_EMAIL=
E2E_ENTERPRISE_ARCHITECT_PASSWORD=
E2E_ARB_MEMBER_1_EMAIL=
E2E_ARB_MEMBER_1_PASSWORD=
E2E_ARB_MEMBER_2_EMAIL=
E2E_ARB_MEMBER_2_PASSWORD=
E2E_ARB_CHAIR_EMAIL=
E2E_ARB_CHAIR_PASSWORD=
E2E_PMO_EMAIL=
E2E_PMO_PASSWORD=
E2E_TECH_EXCO_EMAIL=
E2E_TECH_EXCO_PASSWORD=
E2E_FINANCE_EXCO_EMAIL=
E2E_FINANCE_EXCO_PASSWORD=
# Added in TechCockpit with Type = Vendor (Users page)
E2E_VENDOR_EMAIL=
E2E_VENDOR_PASSWORD=
