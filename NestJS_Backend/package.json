{
  "name": "NestJS_Backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start --exec \"node --use-system-ca\"",
    "start:dev": "nest start --watch --exec \"node --use-system-ca\"",
    "start:debug": "nest start --debug --watch --exec \"node --use-system-ca\"",
    "start:prod": "node dist/main",
    "lint": "eslint src test",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --project e2e",
    "db": "node scripts/tsx.mjs src/database/cli/db.ts",
    "test:int": "vitest run --project integration",
    "test:all": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "bootstrap:admin": "node scripts/tsx.mjs src/scripts/bootstrap-admin.ts",
    "trm:sync": "node scripts/tsx.mjs src/scripts/trm-sync.ts",
    "openapi": "nest build && node dist/scripts/generate-openapi.js"
  },
  "dependencies": {
    "@azure/identity": "^4.14.0",
    "@azure/storage-blob": "^12.34.0",
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.5",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@node-saml/node-saml": "^5.1.0",
    "cookie": "^2.0.1",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "pdfmake": "^0.3.12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pdfmake": "^0.3.3",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.13.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "8.1.6",
    "vitest": "^4.1.2",
    "xml-crypto": "^6.3.3"
  },
  "overrides": {
    "multer": "2.5.0",
    "@azure/msal-node": "7.1.0",
    "esbuild": "npm:esbuild-wasm@0.28.2"
  },
  "engines": {
    "node": ">=24"
  }
}
